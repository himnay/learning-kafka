      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"libraryEventId\": null,\n  \"book\": {\n    \"bookId\": 456,\n    \"bookName\": \"Kafka Using Spring Boot\",\n    \"bookAuthor\": \"Dilip\"\n  }\n}"
      }

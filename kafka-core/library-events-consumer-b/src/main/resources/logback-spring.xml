<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration (Spring Boot's default logging backend; the "-spring" suffix lets Boot
  pre-process it, so <springProperty> can read application.yml).
  - Console: Spring Boot's coloured default pattern
  - File:    logs/<app-name>.log, rolled daily or at 10 MB, gzipped, 7 days kept
-->
<configuration>

    <!-- Base-event metadata from the MDC (EventMetadataMdcInterceptor): "[LibraryEvent.NEW:<eventId>] ".
         Defined before defaults.xml so Boot's console pattern picks it up; %replace hides the empty
         brackets on lines logged outside record processing. -->
    <property name="LOG_CORRELATION_PATTERN" value="%replace([%X{eventType:-}:%X{eventId:-}] ){'\[:\] ', ''}"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${APP_NAME}] [%thread] ${LOG_CORRELATION_PATTERN}%logger{40} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Application code -->
    <logger name="com.learnkafka" level="DEBUG"/>

    <!-- Kafka / Confluent print every config value at INFO on each client start — keep them quiet -->
    <logger name="org.apache.kafka.common.config.AbstractConfig" level="WARN"/>
    <logger name="io.confluent.kafka.serializers" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>

{
  "name": "LibraryEventAvro",
  "aliases": [
    "LibraryEvent"
  ],
  "namespace": "com.learnkafka.avro",
  "type": "record",
  "doc": "Generated as LibraryEventAvro / BookAvro / LibraryEventTypeAvro so the names never clash with the REST records or JPA entities. The aliases keep the renamed schema compatible with version 1 (LibraryEvent / Book / LibraryEventType). A library event published to the library-events topic. Registered in Schema Registry under subject library-events-value.",
  "fields": [
    {
      "name": "metadata",
      "type": [
        "null",
        "com.learnkafka.avro.EventMetadataAvro"
      ],
      "default": null,
      "doc": "Base-event properties. Optional (default null) so the schema stays BACKWARD-compatible with events written before it existed."
    },
    {
      "name": "libraryEventId",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Null for NEW events (the consumer's database assigns it); required for UPDATE."
    },
    {
      "name": "libraryEventType",
      "type": {
        "type": "enum",
        "name": "LibraryEventTypeAvro",
        "aliases": [
          "LibraryEventType"
        ],
        "symbols": [
          "NEW",
          "UPDATE"
        ]
      }
    },
    {
      "name": "book",
      "type": {
        "type": "record",
        "name": "BookAvro",
        "aliases": [
          "Book"
        ],
        "fields": [
          {
            "name": "bookId",
            "type": "int"
          },
          {
            "name": "bookName",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            }
          },
          {
            "name": "bookAuthor",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            }
          }
        ]
      }
    }
  ]
}
